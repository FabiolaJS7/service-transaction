    transactionRepository.save(
    com.bootcamp.service.transaction.model.Transaction@472a11ae
);
    -> at com.bootcamp.service.transaction.service.impl.TransactionServiceImpl.lambda$createTransaction$1(TransactionServiceImpl.java:24)
